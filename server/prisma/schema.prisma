generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  approvalPending
  returnPending
  returned
  rejected
}

enum UserType {
  Admin
  User
}

// User space  ------------------------------

model Group {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  UserGroup UserGroup[]

  @@map("group")
}

model User {
  id               Int           @id @default(autoincrement())
  username         String
  email            String        @unique
  hashedPassword   String        @map("hashed_password")
  isActive         Boolean       @map("is_active")
  // userType       UserType    @map("user_type")
  isAdmin          Boolean       @map("is_admin")
  userGroups       UserGroup[]   @relation(name: "user_group_user")
  adminUserGroups  UserGroup[]   @relation(name: "user_group_admin")
  Asset            Asset[]
  requestedByUsers Request[]     @relation(name: "request_requested_by")
  respondedByUsers Request[]     @relation(name: "request_responded_by")
  Transaction      Transaction[]

  @@map("user")
}

model UserGroup {
  user         User     @relation(name: "user_group_user", fields: [userId], references: [id])
  userId       Int
  group        Group    @relation(fields: [groupId], references: [id])
  groupId      Int
  underAdmin   User?    @relation(name: "user_group_admin", fields: [underAdminId], references: [id])
  underAdminId Int?     @map("under_admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isActive     Boolean  @map("is_active")

  @@id([userId, groupId])
}

// Asset space --------------------------------
model PlaceType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @map("is_active")
  places    Place[]

  @@map("place_type")
}

model Place {
  id                   Int           @id @default(autoincrement())
  placeType            PlaceType     @relation(fields: [placeTypeId], references: [id])
  placeTypeId          Int           @map("place_type_id")
  parent               Place?        @relation(name: "child_place", fields: [parentId], references: [id])
  parentId             Int?          @map("parent_id")
  description          String?
  isActive             Boolean       @map("is_active")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  Place                Place[]       @relation(name: "child_place")
  Asset                Asset[]       @relation("place_to_assets")
  placeId              Int?
  Transaction          Transaction[]
  fromPlaceTransaction Transaction[] @relation("from_place_transaction")
  toPlaceTransaction   Transaction[] @relation("to_place_transaction")

  @@map("place")
}

model Asset {
  rfid           String        @id
  place          Place         @relation("place_to_assets", fields: [placeId], references: [id])
  placeId        Int           @map("place_id")
  partNumber     Int
  partNumberData PartNumber    @relation(fields: [partNumber], references: [id])
  assetType      AssetType     @relation(fields: [assetTypeId], references: [id])
  assetTypeId    Int           @map("asset_type_id")
  fields         Json
  isActive       Boolean       @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  User           User?         @relation(fields: [userId], references: [id])
  userId         Int?
  request        Request?      @relation(fields: [requestId], references: [id])
  requestId      Int?
  Transaction    Transaction[]

  @@map("asset")
}

model PartNumber {
  id                  Int                   @id @default(autoincrement())
  quantityInUse       Int
  totalQuantity       Int
  quantityAvailable   Int
  isActive            Boolean               @map("is_active")
  assetType           AssetType             @relation(fields: [assetTypeId], references: [id])
  assetTypeId         Int
  assets              Asset[]
  RequestToPartnumber RequestToPartnumber[]
}

model AssetType {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isActive    Boolean      @map("is_active")
  assets      Asset[]
  partNumbers PartNumber[]

  @@map("asset_type")
}

model Request {
  id                 Int                   @id @default(autoincrement())
  requestedBy        User                  @relation(name: "request_requested_by", fields: [requestedByUserId], references: [id])
  requestedByUserId  Int                   @map("requsted_by_user_id")
  respondedBy        User                  @relation(name: "request_responded_by", fields: [respondedByUserId], references: [id])
  respondedByUserId  Int                   @map("responded_by_user_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  status             RequestStatus
  respondedAt        DateTime?
  isActive           Boolean               @map("is_active")
  assets             Asset[]
  partNumberRequests RequestToPartnumber[]
  Transaction        Transaction[]
}

model RequestToPartnumber {
  id               Int           @id @default(autoincrement())
  status           String
  quantity         Int?
  acceptedQuantity Int?
  rejectedQuantity Int?
  request          Request       @relation(fields: [requestId], references: [id])
  requestId        Int
  partNumber       PartNumber    @relation(fields: [partNumberId], references: [id])
  partNumberId     Int
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  Transaction      Transaction[]

  @@map("request_to_partnumber")
}

model Transaction {
  id                  Int                  @id @default(autoincrement())
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  isActive            Boolean              @map("is_active")
  status              String
  movedBy             User?                @relation(fields: [movedById], references: [id])
  movedById           Int?
  from                Place?               @relation("from_place_transaction", fields: [fromId], references: [id])
  fromId              Int?
  asset               Asset                @relation(fields: [assetId], references: [rfid])
  assetId             String
  to                  Place?               @relation("to_place_transaction", fields: [toId], references: [id])
  toId                Int?
  request             Request              @relation(fields: [requestId], references: [id])
  requestId           Int                  @map("request_id")
  partNumberRequest   RequestToPartnumber? @relation(fields: [partNumberRequestId], references: [id])
  partNumberRequestId Int?                 @map("part_number_request_id")
  Place               Place?               @relation(fields: [placeId], references: [id])
  placeId             Int?
}
